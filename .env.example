# Public browser configuration. Copy this file to ignored .env.local for local use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# sample = fictional preview; live = database-backed events with no sample fallback.
VITE_DATA_MODE=sample

# Server-only configuration. The publishable key may match the browser key.
# Never prefix database credentials or AI credentials with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Optional PEM CA certificate when the database provider requires custom trust.
DATABASE_CA_CERT=

# Server-only Grow Neighbor integration. Obtain the key from Google AI Studio.
GEMINI_API_KEY=
# Supported Flash Lite alias verified with the official SDK; override if needed.
GEMINI_MODEL=gemini-flash-lite-latest
